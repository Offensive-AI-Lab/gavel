cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "GAVEL: Towards Rule-Based Safety Through Activation Monitoring"
version: "1.0"
date-released: 2026-05-12
doi: "10.5281/zenodo.20131858"
url: "https://github.com/Offensive-AI-Lab/gavel"
repository-code: "https://github.com/Offensive-AI-Lab/gavel"
license: Apache-2.0
type: software

abstract: "GAVEL is a framework for rule-based activation safety in large language models. It decomposes model behavior into Cognitive Elements (CEs), fine-grained, interpretable behavioral and conceptual factors, and composes them into logical predicate rules to detect safety or policy violations."

